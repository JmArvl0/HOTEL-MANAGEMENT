# Copy to .env.local (which is gitignored) and fill in.
# Every variable below is optional in development: with none of them set the
# app boots in demo mode against in-memory data. Production is stricter —
# lib/env.ts refuses to start if anything here is missing or insecure.

# ---------------------------------------------------------------------------
# Auth (NextAuth)
# ---------------------------------------------------------------------------
# Absolute URL of the deployment. Required in production for callback URLs.
NEXTAUTH_URL=http://localhost:3000

# JWT signing secret. Required in production, min 32 chars, and must not be the
# development placeholder. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ---------------------------------------------------------------------------
# Database (Supabase)
# ---------------------------------------------------------------------------
# Set BOTH to run against Postgres, or leave BOTH blank for demo mode.
# Production requires them — it will not silently fall back to demo data.
# The service-role key bypasses RLS: server-side only, never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Migrations (scripts/migrate.mjs only — not read by the app)
# ---------------------------------------------------------------------------
# Direct (non-pooled, port 5432) Postgres connection string. `npm run migrate`
# applies supabase/schema.sql over this; the pooler rejects DDL sessions.
# Supabase dashboard → Project Settings → Database → Connection string → URI.
DIRECT_URL=

# ---------------------------------------------------------------------------
# Google Gemini AI (innovation layer — SERVER-SIDE ONLY)
# ---------------------------------------------------------------------------
# API key from Google AI Studio. Read only by lib/ai/* on the server.
# Never expose as NEXT_PUBLIC_*; a missing key only disables AI explanations.
GEMINI_API_KEY=

# Optional override. Defaults to gemini-3.6-flash. Set this to move to a
# different stable Gemini model without code changes.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Analytics cron (innovation layer)
# ---------------------------------------------------------------------------
# Shared secret Vercel's daily cron sends as `Authorization: Bearer <secret>`
# to /api/analytics/generate. Optional — without it only the authorized manual
# refresh can generate prediction snapshots.
CRON_SECRET=

# ---------------------------------------------------------------------------
# PayMongo online payments (SERVER-SIDE ONLY — GCash auto-pay deposits)
# ---------------------------------------------------------------------------
# Both blank (default) = instant online payment is hidden; the manual GCash
# transfer + staff verification flow is the only deposit path. Set BOTH to
# enable the GCash Instant Auto-Pay option at /booking/payment/[token].
# Secret key from the PayMongo Dashboard → Developers (sk_test_… for sandbox,
# sk_live_… for production). The legacy names PAYMENT_GATEWAY_SECRET_KEY /
# PAYMENT_GATEWAY_WEBHOOK_SECRET still work as aliases.
PAYMONGO_SECRET_KEY=
# Per-webhook signing secret from the same Developers screen. The webhook
# route verifies the Paymongo-Signature header (HMAC-SHA256) before any
# database read. Register the endpoint as
# <NEXTAUTH_URL>/api/webhooks/payments subscribing to
# checkout_session.payment.paid and payment.failed.
PAYMONGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Guest email notifications (SERVER-SIDE ONLY)
# ---------------------------------------------------------------------------
# Resend API key (https://resend.com). Read only by lib/email.ts on the server.
# Never expose as NEXT_PUBLIC_*; a missing key only disables guest emails —
# in-app notifications still work.
RESEND_API_KEY=

# Verified sender identity in Resend. Defaults to
# "Haven Hotel <onboarding@resend.dev>" (Resend's test sender) when blank.
RESEND_FROM=

# ---------------------------------------------------------------------------
# Login OTP email via Nodemailer SMTP (SERVER-SIDE ONLY)
# ---------------------------------------------------------------------------
# Read only by lib/otp-transport.ts on the server. All blank = OTP email
# unconfigured: login OTP stays off and the admin delivery panel reports
# Unknown — never Ready. Configure, then pass the connection test in
# System Administration → Security Configuration before enabling login OTP.
# Port 465 negotiates TLS immediately; 587 upgrades via STARTTLS.
SMTP_HOST=
SMTP_PORT=
# Optional: "true" forces TLS-from-connect, "false" forces STARTTLS.
# Blank auto-selects (465 → TLS, anything else → STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Server-only HMAC secret binding each OTP to its challenge. Required before
# any code can be issued; generate one with: openssl rand -base64 32
OTP_HASH_SECRET=

# ---------------------------------------------------------------------------
# Not used by this app
# ---------------------------------------------------------------------------
# The Supabase dashboard also hands out DATABASE_URL, SUPABASE_URL,
# SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SECRET_KEY and SUPABASE_JWKS_URL. Nothing reads them — safe to omit.
