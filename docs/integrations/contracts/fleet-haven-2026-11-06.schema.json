      "allOf": [
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "create"
              }
            }
          },
          "then": {
            "required": [
              "request"
            ],
            "properties": {
              "external_revision": {
                "const": 1
              },
              "expected_request_version": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
